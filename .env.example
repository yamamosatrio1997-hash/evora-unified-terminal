# Copy to .env and fill in. NEVER commit .env. Placeholders only.
APP_ENV=production
LOG_LEVEL=INFO

# --- Database (docker compose creates these) ---
POSTGRES_USER=tcc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tcc
DATABASE_URL=postgresql+psycopg://tcc:change-me@postgres:5432/tcc

# --- Security (generate with: openssl rand -hex 32) ---
SESSION_SECRET=change-me
SERVICE_TOKEN=change-me
COOKIE_SECURE=true
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
CORS_ORIGINS=
# Public self-registration creates read-only "viewer" accounts. Set false to close signups.
ALLOW_SIGNUP=true
SIGNUP_RATE_LIMIT_PER_HOUR=5

# --- Trading mode: live trading cannot be enabled by config (startup refuses true) ---
LIVE_TRADING_ENABLED=false
PAPER_STARTING_EQUITY=10000

# --- Risk limits (fractions). MAX_PLANNED_RISK_PER_TRADE cannot exceed 0.03 ---
MAX_PLANNED_RISK_PER_TRADE=0.03
DEFAULT_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_PORTFOLIO_EXPOSURE=1.5
MAX_CORRELATED_RISK=0.05
MAX_DRAWDOWN_HALT=0.20
DRAWDOWN_RISK_REDUCTION_START=0.10
MAX_LEVERAGE=3
DATA_STALE_AFTER_SECONDS=900

# --- Market data ---
WATCH_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_SPOT_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
COINGECKO_API_KEY=
FRED_API_KEY=

# --- LLM (optional; without it agents run deterministic analysis only) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-opus-4-7
DEBATE_TOKEN_BUDGET=60000
DEBATE_COST_BUDGET_USD=2.00
LLM_INPUT_COST_PER_MTOK=5
LLM_OUTPUT_COST_PER_MTOK=25

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=

# --- MEXC read-only (optional; create a READ-ONLY, IP-restricted key, no withdrawal) ---
MEXC_API_KEY=
MEXC_API_SECRET=

# --- n8n ---
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_ENCRYPTION_KEY=change-me
N8N_DB_PASSWORD=change-me
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
DOMAIN=
FRONTEND_BIND=127.0.0.1
N8N_HOST=localhost
