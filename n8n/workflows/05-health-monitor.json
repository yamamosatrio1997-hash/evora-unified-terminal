{
  "id": "tccHealthMon0001",
  "name": "TCC 05 - Health monitor & alerts (10 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "42656da9-1ae0-5d1c-a648-aebde13e5481",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/health/deep",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b500158a-c0f6-5534-ba9d-9a53ada12293",
      "name": "Deep health check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "tccServiceToken1",
          "name": "TCC Service Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "d39ae4aa-2b49-5154-97d2-a6c4b3876799",
              "leftValue": "={{ $json.healthy }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6e75e6ab-39f0-5d9d-9636-ee60f9851ef7",
      "name": "Unhealthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/service/telegram/push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: \"alert\", message: \"Health check gagal. Masalah: \" + ($json.problems || []).join(\", \") + ($json.emergency_stop ? \" | EMERGENCY STOP AKTIF\" : \"\") }) }}"
      },
      "id": "4ffeaa6e-ec1b-5ea5-9bb0-aa861bdd8b32",
      "name": "Send Telegram alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "tccServiceToken1",
          "name": "TCC Service Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/service/n8n/callback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_id: $workflow.id, workflow_name: $workflow.name, execution_id: $execution.id, status: \"success\", started_at: $execution.startedAt ? $execution.startedAt : null, finished_at: $now.toISO() }) }}"
      },
      "id": "11f06a8b-9b12-57be-bfbe-d3f236526aa4",
      "name": "Report success to backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "tccServiceToken1",
          "name": "TCC Service Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "66baf85c-9624-59c6-a11f-b37fc83181bf",
      "name": "Run on demand",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ]
    }
  ],
  "connections": {
    "Every 10 minutes": {
      "main": [
        [
          {
            "node": "Deep health check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deep health check": {
      "main": [
        [
          {
            "node": "Unhealthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unhealthy?": {
      "main": [
        [
          {
            "node": "Send Telegram alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report success to backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram alert": {
      "main": [
        [
          {
            "node": "Report success to backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run on demand": {
      "main": [
        [
          {
            "node": "Deep health check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 900,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "tccErrorHandler1",
    "timezone": "UTC"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "versionId": "e1202074-35fa-5231-a14b-0c6bf73e6523"
}